{
  "name": "vite-svgee-plugin",
  "version": "1.0.1",
  "description": "Import SVG files as React components in Vite with zero runtime overhead.",
  "license": "MIT",
  "author": "Peter Shershov",
  "homepage": "https://github.com/PeterShershov/vite-svgee-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterShershov/vite-svgee-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/PeterShershov/vite-svgee-plugin/issues"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "svg",
    "svgr",
    "react",
    "jsx",
    "svgo",
    "icons"
  ],
  "type": "module",
  "files": [
    "dist",
    "client.d.ts"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test tests/*.test.ts",
    "bench": "node --expose-gc bench/run.ts",
    "prepack": "npm run build"
  },
  "overrides": {
    "@svgr/plugin-svgo": {
      "svgo": "$svgo"
    }
  },
  "peerDependencies": {
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "svgo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "svgo": "^4.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^5.2.0"
  }
}
